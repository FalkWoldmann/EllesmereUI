{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "Lua5.1"
  },
  "workspace": {
    "library": [
      ".tools/cache/wow-api/Annotations/Core",
      ".tools/cache/framexml-src/Annotations"
    ],
    "ignoreDir": [
      ".tools",
      ".git",
      "Libs",
      "EllesmereUIUnitFrames/Libs"
    ],
    "ignoreGlobs": [
      ".tools/**",
      "Libs/**",
      "EllesmereUIUnitFrames/Libs/**"
    ]
  },
  "diagnostics": {
    "disable": [
      "unused",
      "redefined-local",
      "deprecated",
      "duplicate-doc-field",
      "access-invisible",
      "unnecessary-if",
      "preferred-local-alias",
      "call-non-callable",
      "await-in-sync"
    ],
    "severity": {
      "undefined-global": "error",
      "global-in-non-module": "error"
    },
    "globals": [
      "CUSTOM_CLASS_COLORS",
      "NSAPI",
      "EasyNicknameAPI",
      "LiquidAPI",
      "TimelineReminders",
      "RG_ALTS_SETTINGS",
      "FarmHud",
      "PawnCommon",
      "PawnRegisterThirdPartyBag",
      "PawnShouldItemLinkHaveUpgradeArrow"
    ]
  }
}
